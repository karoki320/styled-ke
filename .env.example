# Copy this file to .env.local and fill in real values as you connect each
# service. The app runs and is fully clickable with NONE of these set —
# missing integrations just fall back to mock data / disabled buttons with a
# clear message, so you can wire things up one at a time.

# ── Supabase (Database + Auth + Storage) ───────────────────────────────
# Create a project at https://supabase.com, then run supabase/migrations/0001_init.sql
# in the SQL editor. Keys are under Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses Row Level Security. NEVER expose
# this to the browser or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=

# ── Paystack (card + M-Pesa checkout) ──────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developers
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Meta WhatsApp Cloud API ─────────────────────────────────────────────
# Set up at https://developers.facebook.com/apps -> WhatsApp product.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ID=
# Any string you choose — enter the same value when configuring the webhook
# URL in the Meta App Dashboard.
WHATSAPP_VERIFY_TOKEN=styled_ke_webhook_2026
# Where new-order alerts are sent (E.164, no +).
OWNER_WHATSAPP_NUMBER=254734807511

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=254734807511

# ── Email (order receipts — customers are never called before delivery,
# the emailed receipt is their confirmation) ─────────────────────────────
# https://resend.com — create an API key, then verify a sending domain
# (Resend Dashboard -> Domains) so RESEND_FROM_EMAIL delivers reliably.
# Until a domain is verified, receipts fall back to Resend's shared
# onboarding@resend.dev sender, which is fine for testing.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Styled.ke <orders@styled.ke>"
